DATABASE_URL=postgres://app_user:app_pass@localhost:5432/ketoan
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/ketoan
SESSION_SECRET=doi-chuoi-nay-khi-trien-khai
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Chỉ đặt khi API chạy sau reverse proxy: số bước proxy (1 cho mỗi lớp proxy, ví dụ 2 sau nginx proxy manager + nginx của web) hoặc danh sách IP/CIDR của proxy.
# Không dùng true: client tự gửi X-Forwarded-For được và giả IP, vượt giới hạn đăng nhập theo IP.
TRUST_PROXY=false
# NODE_ENV=production bắt buộc SESSION_SECRET >= 32 ký tự (khác giá trị mẫu) và COOKIE_SECURE=true
# Khóa mã hóa mật khẩu nhà cung cấp hóa đơn, khóa API ngân hàng: `openssl rand -base64 32`. Bắt buộc khi NODE_ENV=production; mất khóa thì phải nhập lại các bí mật đã lưu.
DATA_ENCRYPTION_KEY=
# Địa chỉ công khai để in URL webhook (ví dụ https://ketoan.example.vn). Bắt buộc đặt khi triển khai sau TLS, nếu không URL webhook dựng từ Host của yêu cầu.
# PUBLIC_BASE_URL=
PORT=3000
BACKUP_DIR=./backups
ATTACHMENT_DIR=./attachments
WEB_ORIGIN=http://localhost:5173
# VNPT SmartCA: chỉ gọi tới các máy chủ này (https), chống SSRF qua địa chỉ người dùng nhập. Mặc định: cổng UAT và Production.
# SMARTCA_ALLOWED_HOSTS=rmgateway.vnptit.vn,gwsca.vnpt.vn
# Chỉ để kiểm thử với máy giả chạy http; bị từ chối khi NODE_ENV=production.
# SMARTCA_ALLOW_HTTP=false
# Hóa đơn điện tử (SInvoice): chỉ gọi tới các máy chủ này (https, cổng mặc định), chống SSRF qua baseUrl người dùng nhập. Rỗng = api-vinvoice.viettel.vn; thêm máy chủ demo của Viettel khi có.
# EINVOICE_ALLOWED_HOSTS=
# Chỉ để kiểm thử với máy giả chạy http; bị từ chối khi NODE_ENV=production.
# EINVOICE_ALLOW_HTTP=false
# Trợ lý nhận diện hóa đơn ảnh/PDF (GĐ7 nhóm 7), mặc định TẮT. XML hóa đơn điện tử luôn đọc cục bộ. Chưa thử trên môi trường thật.
# Dù bật, tệp chỉ rời máy chủ khi công ty bật "gửi tệp ra dịch vụ nhận diện" ở màn Trợ lý và người dùng chọn gửi ở từng lần (ghi nhật ký).
# RECOGNIZER_PROVIDER=off          # off | http (dịch vụ OCR theo hợp đồng JSON của RECOGNIZER_URL) | anthropic (Claude đọc ảnh/PDF)
# RECOGNIZER_URL=https://ocr.example.vn/v1/invoice
# RECOGNIZER_API_KEY=
# RECOGNIZER_MODEL=
# RECOGNIZER_TIMEOUT_MS=30000
